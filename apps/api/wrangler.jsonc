{
  "name": "testmeman-ai-interviewer-api",
  "compatibility_date": "2024-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testmeman-ai-interviewer-db",
      "database_id": "1b87fbdf-8bae-4a1f-932a-eef35c661d3f"
    }
  ],
  "vars": {
    "GEMINI_MODEL_INTERVIEWER": "gemini-3.1-flash-lite",
    "GEMINI_MODEL_EVALUATOR": "gemini-3.1-flash-lite",
    "CODE_RUNNER": "judge0",
    "JUDGE0_URL": "http://127.0.0.1:2358"
  }
}
